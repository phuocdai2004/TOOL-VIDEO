# AI providers
AGNES_API_KEY=
GEMINI_API_KEY=

# MongoDB authentication store
MONGODB_URI=mongodb://127.0.0.1:27017/?serverSelectionTimeoutMS=5000
MONGODB_DB=agnes_video

# Account policy
ALLOW_REGISTRATION=true
ADMIN_EMAIL=

# Set true behind HTTPS in production. Local HTTP detects false automatically.
AUTH_COOKIE_SECURE=false

# Password recovery email (example: Gmail SMTP with an App Password)
PUBLIC_BASE_URL=http://localhost:8765
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
